{
  "name": "dsh-localsend",
  "version": "0.2.0",
  "description": "局域网文件/文件夹传输插件:通过 LocalSend v2 协议把文件(或自动打包成 zip 的文件夹)发送到运行 LocalSend 的机器。零配置、开箱即用,兼容 dsh 0.1.1-rc.2 与 0.1.3-alpha.1。",
  "type": "module",
  "main": "index.js",
  "license": "MIT",
  "author": "huangfuren",
  "scripts": {
    "check": "node --check index.js && node --check client.js && node --check lib/constants.js && node --check lib/net.js && node --check lib/discovery.js && node --check lib/pack.js && node --check lib/protocol.js && node --check lib/transfer.js && node --check lib/zip.js && node --check lib/tools/list.js && node --check lib/tools/send.js",
    "test": "node --test",
    "verify": "npm run check && npm test",
    "prepack": "npm run verify"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "localsend",
    "lan",
    "file-transfer"
  ],
  "engines": {
    "node": ">=22.19",
    "dsh": ">=0.1.1-rc.2 <0.2.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/huangfuren/dsh-localsend.git"
  },
  "homepage": "https://github.com/huangfuren/dsh-localsend#readme",
  "bugs": {
    "url": "https://github.com/huangfuren/dsh-localsend/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": ">=3.18.1 <4.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.6 <0.2.0",
    "@deepseek-ai/cordis": ">=4.0.1 <5",
    "@deepseek-ai/dsh-client-runtime": ">=0.1.0-rc.6 <0.2.0",
    "@deepseek-ai/dsh-client-connection": ">=0.1.0-rc.6 <0.2.0",
    "@deepseek-ai/dsh-api-remotes": ">=0.1.0-rc.6 <0.2.0",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.0-rc.6 <0.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-tools": "0.1.0-rc.6"
  }
}
